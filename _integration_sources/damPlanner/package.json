{
  "name": "damplanner", "version": "0.1.0", "private": true, "type": "module", "packageManager": "pnpm@10.28.1",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json && concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main/main.js && electron .\"",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings=0", "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --root . tests/unit", "test:integration": "vitest run --root . tests/integration", "test:e2e": "playwright test",
    "build": "vite build && tsc -p tsconfig.electron.json", "package": "pnpm build && electron-builder --linux dir",
    "package:win": "pnpm build && electron-builder --win nsis --x64", "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "dependencies": {"@libsql/client":"^0.15.15","drizzle-orm":"^0.44.5","luxon":"^3.7.2","react":"^19.1.1","react-dom":"^19.1.1","zod":"^4.1.5"},
  "devDependencies": {"@eslint/js":"^9.34.0","@playwright/test":"^1.55.0","@testing-library/react":"^16.3.0","@types/luxon":"^3.7.1","@types/node":"^24.3.0","@types/react":"^19.1.12","@types/react-dom":"^19.1.9","@vitejs/plugin-react":"^5.0.2","concurrently":"^9.2.1","drizzle-kit":"^0.31.4","electron":"^37.4.0","electron-builder":"^26.0.12","eslint":"^9.34.0","eslint-plugin-react-hooks":"^5.2.0","jsdom":"^26.1.0","typescript":"^5.9.2","typescript-eslint":"^8.41.0","vite":"^7.1.3","vitest":"^3.2.4","wait-on":"^8.0.4"},
  "build": {"appId":"fr.damplanner.app","productName":"DamPlanner","files":["dist/**","dist-electron/**","package.json"],"win":{"target":"nsis","artifactName":"DamPlanner Setup.${ext}"},"nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true}}
}
