{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "electron": [
        "types/electron/index.d.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "integrations/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "tests/electron.smoke.spec.ts",
    "playwright.electron.config.ts",
    "_integration_sources/**",
    "node_modules/**",
    "dist/**"
  ]
}
